    "container": {
      "$type": "dimension",
      "$value": "1200px"
    },
    "breakpoint-mobile": {
      "$type": "dimension",
      "$value": "600px"
    },
    "breakpoint-tablet": {
      "$type": "dimension",
      "$value": "900px"
    }
