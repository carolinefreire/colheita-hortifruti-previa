  "status": {
    "official": [
      "color.brand",
      "font.family",
      "marca, variações, monograma, ícones e padrões representados no painel"
    ],
    "proposed": [
      "color.semantic",
      "size",
      "space",
      "radius",
      "border",
      "layout",
      "comportamento dos componentes"
    ]
  },
  "component": {
    "icon": {
      "stroke": {
        "$type": "dimension",
        "$value": "1.8px"
      },
      "size-default": {
        "$type": "dimension",
        "$value": "24px"
      },
      "color-default": {
        "$type": "color",
        "$value": "{color.brand.brown}"
      },
      "status": "proposta"
    },
    "badge": {
      "shape": "pill",
      "padding-compact": "5px 9px",
      "padding-normal": "8px 13px",
      "organic-background": "{color.brand.green}",
      "organic-foreground": "{color.brand.brown}",
      "status": "proposta"
    },
    "product": {
      "badge-placement": "top-left",
      "max-priority-badges": 2,
      "status": "proposta"
    }
  },
  "usageRules": {
    "organic": {
      "requiresVerifiedProductOrganicStatus": true,
      "isCertificationSeal": false,
      "mustNotImitateSisOrg": true,
      "showOnlyWhenEligible": true
    },
    "limitedStock": {
      "requiresLiveInventory": true
    },
    "seasonal": {
      "requiresSeasonalVerification": true
    },
    "local": {
      "requiresProducerOriginConfirmation": true
    },
    "promotion": {
      "requiresEffectiveOffer": true
    }
  }
}