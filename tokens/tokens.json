{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Colheita Hortifruti",
    "version": "2.0.0",
    "source": "Painel de Identidade Colheita Hortifruti(4).png",
    "source_status": "aprovado_sem_alteracoes",
    "note": "Paleta e fontes aprovadas e inalteradas; ícones auxiliares e etiquetas da v2 são propostas de componentes, sujeitas à aprovação. Nenhum ícone oficial do painel foi substituído."
  },
  "color": {
    "brand": {
      "brown": {
        "$type": "color",
        "$value": "#5B2E08",
        "$description": "Aprovada; cor escura principal."
      },
      "orange": {
        "$type": "color",
        "$value": "#E85D2A",
        "$description": "Aprovada; acento."
      },
      "yellow": {
        "$type": "color",
        "$value": "#F6A623",
        "$description": "Aprovada; acento."
      },
      "green": {
        "$type": "color",
        "$value": "#68BF2A",
        "$description": "Aprovada; acento."
      },
      "cream": {
        "$type": "color",
        "$value": "#FFF3E6",
        "$description": "Aprovada; fundo."
      }
    },
    "semantic": {
      "background": {
        "$type": "color",
        "$value": "{color.brand.cream}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.brand.brown}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.brand.brown}"
      },
      "on-primary": {
        "$type": "color",
        "$value": "{color.brand.cream}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.brand.cream}"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.brand.yellow}"
      },
      "promotional-accent": {
        "$type": "color",
        "$value": "{color.brand.orange}"
      },
      "nature-accent": {
        "$type": "color",
        "$value": "{color.brand.green}"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": "Baloo 2",
        "$description": "Oficial; títulos."
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Nunito",
        "$description": "Oficial; textos."
      }
    }
  },
  "size": {
